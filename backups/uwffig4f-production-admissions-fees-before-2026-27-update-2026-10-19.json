                "children": [
                  {
                    "_key": "method-2-span",
                    "_type": "span",
                    "text": "Current dated cheque"
                  }
                ],
                "level": 1,
                "listItem": "number",
                "style": "normal"
              },
              {
                "_key": "method-3",
                "_type": "block",
                "children": [
                  {
                    "_key": "method-3-span",
                    "_type": "span",
                    "text": "Post-dated cheques"
                  }
                ],
                "level": 1,
                "listItem": "number",
                "style": "normal"
              },
              {
                "_key": "method-4",
                "_type": "block",
                "children": [
                  {
                    "_key": "method-4-span",
                    "_type": "span",
                    "text": "Credit card (Visa or Mastercard)"
                  }
                ],
                "level": 1,
                "listItem": "number",
                "style": "normal"
              },
              {
                "_key": "method-5",
                "_type": "block",
                "children": [
                  {
                    "_key": "method-5-span",
                    "_type": "span",
                    "text": "Wire transfer"
                  }
                ],
                "level": 1,
                "listItem": "number",
                "style": "normal"
              },
              {
                "_key": "payment-note",
                "_type": "block",
                "children": [
                  {
                    "_key": "payment-note-span",
                    "_type": "span",
                    "marks": [
                      "strong"
                    ],
                    "text": "Please note:"
                  }
                ],
                "style": "normal"
              },
              {
                "_key": "payment-note-1",
                "_type": "block",
                "children": [
                  {
                    "_key": "payment-note-1-span",
                    "_type": "span",
                    "text": "Current dated or post-dated cheques will not be accepted for initial academic year payments unless submitted at least one month before the academic year commences."
                  }
                ],
                "level": 1,
                "listItem": "bullet",
                "style": "normal"
              },
              {
                "_key": "payment-note-2",
                "_type": "block",
                "children": [
                  {
                    "_key": "payment-note-2-span",
                    "_type": "span",
                    "text": "Fees are considered paid only when credited to the school’s bank account."
                  }
                ],
                "level": 1,
                "listItem": "bullet",
                "style": "normal"
              },
              {
                "_key": "payment-note-3",
                "_type": "block",
                "children": [
                  {
                    "_key": "payment-note-3-span",
                    "_type": "span",
                    "text": "A student’s registration is considered complete only after the first payment has been cleared, whether made in cash, by credit card, or wire transfer."
                  }
                ],
                "level": 1,
                "listItem": "bullet",
                "style": "normal"
              },
              {
                "_key": "payment-note-4",
                "_type": "block",
                "children": [
                  {
                    "_key": "payment-note-4-span",
                    "_type": "span",
                    "text": "For wire transfers, all associated bank charges must be covered by the parent/guardian. Only the net amount received in the school’s account will be credited against outstanding fees."
                  }
                ],
                "level": 1,
                "listItem": "bullet",
                "style": "normal"
              }
            ],
            "title": "Payment Methods"
          }
        ],
        "heading": {
          "_type": "sectionHeading",
          "title": "Terms & Conditions"
        },
        "slot": "termsSection"
      },
      {
        "_key": "termsSection-rightColumn",
        "_type": "cardsSection",
        "cards": [
          {
            "_key": "non-payment",
            "_type": "card",
            "body": [
              {
                "_key": "non-payment-intro",
                "_type": "block",
                "children": [
                  {
                    "_key": "non-payment-intro-span",
                    "_type": "span",
                    "text": "The school reserves the following rights regarding non-payment of fees:"
                  }
                ],
                "style": "normal"
              },
              {
                "_key": "non-payment-1",
                "_type": "block",
                "children": [
                  {
                    "_key": "non-payment-1-span",
                    "_type": "span",
                    "text": "To send payment reminders via email, written notices, phone calls, SMS, and parent portal notifications to parents/guardians with outstanding payments."
                  }
                ],
                "level": 1,
                "listItem": "bullet",
                "style": "normal"
              },
              {
                "_key": "non-payment-2",
                "_type": "block",
                "children": [
                  {
                    "_key": "non-payment-2-span",
                    "_type": "span",
                    "text": "To temporarily suspend students for up to three school days per term (consecutively or intermittently) after issuing three payment default notices."
                  }
                ],
                "level": 1,
                "listItem": "bullet",
