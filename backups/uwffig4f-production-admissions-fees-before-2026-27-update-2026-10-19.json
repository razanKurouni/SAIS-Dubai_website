              {
                "_key": "non-payment-3",
                "_type": "block",
                "children": [
                  {
                    "_key": "non-payment-3-span",
                    "_type": "span",
                    "text": "To withhold the provision of learning resources, participation in extra-curricular activities and field trips, and access to school ICT networks, library, laboratories, and other facilities."
                  }
                ],
                "level": 1,
                "listItem": "bullet",
                "style": "normal"
              },
              {
                "_key": "non-payment-4",
                "_type": "block",
                "children": [
                  {
                    "_key": "non-payment-4-span",
                    "_type": "span",
                    "text": "To withhold transfer certificates, grade reports, mark sheets, transcripts, and recommendation letters for any student with outstanding fees."
                  }
                ],
                "level": 1,
                "listItem": "bullet",
                "style": "normal"
              },
              {
                "_key": "non-payment-5",
                "_type": "block",
                "children": [
                  {
                    "_key": "non-payment-5-span",
                    "_type": "span",
                    "text": "To pursue appropriate legal action and/or inform relevant authorities to recover outstanding fees."
                  }
                ],
                "level": 1,
                "listItem": "bullet",
                "style": "normal"
              },
              {
                "_key": "non-payment-6",
                "_type": "block",
                "children": [
                  {
                    "_key": "non-payment-6-span",
                    "_type": "span",
                    "text": "To claim legal fees and associated costs incurred in the recovery of outstanding fees."
                  }
                ],
                "level": 1,
                "listItem": "bullet",
                "style": "normal"
              }
