          {
            "_key": "refund-policy",
            "_type": "card",
            "body": [
              {
                "_key": "refund-intro",
                "_type": "block",
                "children": [
                  {
                    "_key": "refund-intro-span",
                    "_type": "span",
                    "text": "In accordance with the Ministry of Education decree:"
                  }
                ],
                "style": "normal"
              },
              {
                "_key": "refund-1",
                "_type": "block",
                "children": [
                  {
                    "_key": "refund-1-span",
                    "_type": "span",
                    "text": "1. Parents/guardians must provide 30 days’ advance notice of student withdrawal and submit a formal refund request."
                  }
                ],
                "style": "normal"
              },
              {
                "_key": "refund-2",
                "_type": "block",
                "children": [
                  {
                    "_key": "refund-2-span",
                    "_type": "span",
                    "text": "2. Withdrawal prior to the commencement of the academic year:"
                  }
                ],
                "style": "normal"
              },
              {
                "_key": "refund-2a",
                "_type": "block",
                "children": [
                  {
                    "_key": "refund-2a-span",
                    "_type": "span",
                    "text": "If initiated by the parent/guardian: The balance of the first term fee paid will be refunded; registration and admission fees remain non-refundable."
                  }
                ],
                "level": 1,
                "listItem": "bullet",
                "style": "normal"
              },
              {
                "_key": "refund-2b",
                "_type": "block",
                "children": [
                  {
                    "_key": "refund-2b-span",
                    "_type": "span",
                    "text": "If initiated by the school: The amount corresponding to the first term fee paid is refunded, excluding the registration fee."
                  }
                ],
                "level": 1,
                "listItem": "bullet",
                "style": "normal"
              },
              {
                "_key": "refund-3",
                "_type": "block",
                "children": [
                  {
                    "_key": "refund-3-span",
                    "_type": "span",
                    "text": "3. Withdrawal during the school term:"
                  }
                ],
                "style": "normal"
              },
              {
                "_key": "refund-3a",
                "_type": "block",
                "children": [
                  {
                    "_key": "refund-3a-span",
                    "_type": "span",
                    "text": "If a student attends any part of the first week or fails to attend without written notification one week before term commencement: The school retains the full registration or re-registration fee."
                  }
                ],
                "level": 1,
                "listItem": "bullet",
                "style": "normal"
              },
              {
                "_key": "refund-3b",
                "_type": "block",
                "children": [
                  {
                    "_key": "refund-3b-span",
                    "_type": "span",
                    "text": "If a student attends two weeks or less in a term: The school will charge the equivalent of one full month of tuition fees."
                  }
                ],
                "level": 1,
                "listItem": "bullet",
                "style": "normal"
              },
              {
                "_key": "refund-3c",
                "_type": "block",
                "children": [
                  {
                    "_key": "refund-3c-span",
                    "_type": "span",
                    "text": "If a student attends more than two weeks but less than one month: The school will charge the equivalent of two full months of tuition fees."
                  }
                ],
                "level": 1,
                "listItem": "bullet",
                "style": "normal"
              },
              {
                "_key": "refund-3d",
                "_type": "block",
                "children": [
                  {
                    "_key": "refund-3d-span",
                    "_type": "span",
                    "text": "If a student attends more than one month in a term: The school will charge the full-term fee."
                  }
                ],
                "level": 1,
                "listItem": "bullet",
                "style": "normal"
              },
              {
                "_key": "refund-3e",
                "_type": "block",
                "children": [
                  {
                    "_key": "refund-3e-span",
                    "_type": "span",
                    "text": "One month’s fee is calculated as one-tenth of the total annual school fees."
                  }
                ],
                "level": 1,
                "listItem": "bullet",
                "style": "normal"
              }
            ],
            "title": "Refund Policy for Student Withdrawals"
