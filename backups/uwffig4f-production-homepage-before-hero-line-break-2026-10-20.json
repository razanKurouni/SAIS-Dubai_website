  "sections": [
    {
      "_key": "intro",
      "_type": "imageTextSection",
      "heading": {
        "_type": "sectionHeading",
        "description": [
          {
            "_key": "home-intro-1",
            "_type": "block",
            "children": [
              {
                "_key": "home-intro-1-span",
                "_type": "span",
                "text": "SAIS - Dubai combines academic excellence with innovation, leadership development, and a strong commitment to holistic education. The campus is dedicated to preparing students for success through a values-driven American curriculum that promotes confidence, creativity, and lifelong learning."
              }
            ],
            "style": "normal"
          },
          {
            "_key": "868754de505a",
            "_type": "block",
            "children": [
              {
                "_key": "a227217755a6",
                "_type": "span",
                "text": "Students benefit from comprehensive programs in STEM, athletics, arts, music, and languages. As a STEM.org accredited school, SAIS - Dubai places a strong emphasis on innovation, leadership, multilingual development, and meaningful extracurricular engagement that extends learning beyond the classroom."
              }
            ],
            "style": "normal"
          }
        ],
        "title": "Building Bright Futures  with Purpose and Principle"
      },
      "image": {
        "_type": "image",
