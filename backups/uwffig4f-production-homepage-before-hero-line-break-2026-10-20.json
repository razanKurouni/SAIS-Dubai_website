      ],
      "heading": {
        "_type": "sectionHeading",
        "description": [
          {
            "_key": "professional-development",
            "_type": "block",
            "children": [
              {
                "_key": "professional-development-text",
                "_type": "span",
                "text": "Education at SAIS - Dubai is built on strong partnerships between students, families, and staff. Through a culture of trust, collaboration, and shared purpose, students are supported academically, socially, and emotionally while developing the resilience, confidence, and values needed to thrive."
              }
            ],
            "style": "normal"
          },
          {
            "_key": "0b7399d26dd5",
            "_type": "block",
            "children": [
              {
                "_key": "ed289187a331",
                "_type": "span",
                "text": "The campus is fully accredited by NEASC and Cognia and is an authorized College Board testing center, reflecting its commitment to maintaining high international standards."
              }
            ],
            "style": "normal"
          },
          {
            "_key": "078ec63a1cd8",
            "_type": "block",
            "children": [
              {
                "_key": "4902902acc59",
                "_type": "span",
                "text": "Student achievement spans academics, STEM, sports, literacy, and community engagement, and includes top placements in numerous high-profile competitions ranging from the AUS Sharakah Physics Open Day to the Abu Dhabi University AI Programming Competition."
              }
            ],
            "style": "normal"
          }
        ],
        "title": "Educational Approach"
      },
